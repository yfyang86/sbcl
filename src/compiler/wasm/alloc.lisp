  (:generator 100 (vop-not-yet-implemented 'allocate-vector-on-heap type length words result)))

(define-vop (allocate-vector-on-stack)
  (:args (type :scs (unsigned-reg)) (length :scs (any-reg)) (words :scs (any-reg)))
  (:results (result :scs (descriptor-reg)))
  (:arg-types (:or positive-fixnum) (:or positive-fixnum) (:or positive-fixnum))
  (:policy :fast-safe)
  (:vop-var vop)
  (:generator 100 (vop-not-yet-implemented 'allocate-vector-on-stack type length words result)))
