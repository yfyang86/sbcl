 ("dx-cons" (a) ((let ((c (cons a a))) (declare (dynamic-extent c)) (car c))) (5) (nil))

 ;; entry points with optional and rest arguments
 ("optional-arg" (a &optional (b 10)) ((declare (fixnum a b)) (the fixnum (+ a b))) (1) (1 2))
